PIAPI_API_KEY=your-api-key

# ---- PiAPI -> MCP sync task (optional; see "Keeping tools in sync" in README) ----
# Apidog access token with maintainer privilege on the PiAPI project (id 675356).
# Used by `npm run sync` to export the upstream OpenAPI as the source of truth.
APIDOG_ACCESS_TOKEN=
APIDOG_PROJECT_ID=675356
# Source selection: "apidog" (default, needs token above) or "file".
# PIAPI_SYNC_SOURCE=apidog
# When PIAPI_SYNC_SOURCE=file, path to a locally-exported OpenAPI json:
# PIAPI_OPENAPI_FILE=./piapi-openapi.json
