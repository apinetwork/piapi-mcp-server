PIAPI_API_KEY=your-api-key

# ---- PiAPI -> MCP sync task (optional; see README) ----
# Default contract source is the versioned Postman collection in PiAPI Manager's
# GitHub repository. No Apidog credentials and no pricing source are used.
# PIAPI_SYNC_SOURCE=github
# PIAPI_GITHUB_OWNER=Gocyber-world
# PIAPI_GITHUB_REPO=midjourney-http-v2
# PIAPI_GITHUB_PATH=Go API.postman_collection.json
# PIAPI_GITHUB_REF=main
# Optional for a private Manager repository; never commit its value.
# PIAPI_CONTRACT_GITHUB_TOKEN=
# Offline OpenAPI override:
# PIAPI_SYNC_SOURCE=file
# PIAPI_OPENAPI_FILE=./piapi-openapi.json
